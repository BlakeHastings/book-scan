# Generated camera videos. Megabytes each, and rebuilt from the cover
# fixtures whenever they are missing or out of date.
.fixtures/

# Generated by bddgen from features/, on every run.
.features-gen/

node_modules/
playwright-report/
test-results/

# Which run the ux harness has open, and the browser profile it is driving.
# Both are per machine; the screenshots and the log beside them are the record.
ux/runs/.current.json
ux/runs/*/.profile/
