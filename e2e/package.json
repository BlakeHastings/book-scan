{
  "name": "book-scan-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser end to end suite. Gherkin features, run against the app started by Aspire.",
  "scripts": {
    "test": "bddgen && playwright test",
