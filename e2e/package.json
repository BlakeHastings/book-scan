    "ux": "node ux/drive.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.7.3"
  }
}
