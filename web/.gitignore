node_modules/
dist/
# The server bundle (#512). A sibling of dist/ rather than inside it, because
# `server/index.ts` finds the built client at `../dist/` relative to whichever
# of the two files is the entry point, and both have to be one directory below
# web/ for that to be true. See web/scripts/build-server.mjs.
dist-server/
data/
*.local

# One per test file that writes files, made and removed by server/scratchdir.ts.
# They are here rather than under data/ so a test run cannot reach a scratch
# catalogue, and one per file rather than one shared so no file's cleanup can
# delete a directory another file is still using. See #297.
.scratch-*/

# tesseract.js drops this in cwd if cachePath is unset
*.traineddata
vite.config.verify.ts
